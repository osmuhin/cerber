#!/usr/bin/env bash
set -eu

RED='\033[0;31m'
CIAN='\033[0;36m'
PURPLE='\033[0;35m'
YELLOW_FG='\033[1;33m'
NC='\033[0m'

path=$(dirname "$(realpath "$0")")
info_flag=0
dry_run_flag=0

while [[ "$#" -gt 0 ]]; do
	case $1 in
		-i|--info)
			info_flag=1
			shift ;;
		--dry-run)
			dry_run_flag=1
			info_flag=1
			shift ;;
		-*|--*)
			echo "Unknown option $1"
			exit 1 ;;
		*)
			break ;;
	esac
done

if [ ! -f "$path/.env" ]; then
	echo -e "${YELLOW_FG}(warn): ${NC}The .env file is missing, local environment used by default\n"
else
	_preserved_app_env="${APP_ENV-}"
	set -a
	. "$path/.env"
	set +a
	if [ -n "${_preserved_app_env}" ]; then
		export APP_ENV="${_preserved_app_env}"
	fi
fi

export USER_ID=$(id -u)
export GROUP_ID=$(id -g)

composeFileForEnv() {
	local app_env="${1:-}"

	case "$app_env" in
		local|"")
			echo "docker-compose.local.yml"
			;;
		*)
			echo -e "${RED}(error): ${NC}Unsupported APP_ENV=\"${app_env}\". Only local is configured in this cycle." >&2
			return 1
			;;
	esac
}

getInitCommand() {
	local dockerComposeFiles=()
	local app_env=""
	local compose_file=""

	if [ ! -f "$path/.env" ]; then
		app_env="local"
	else
		app_env="${APP_ENV:-}"
	fi

	if ! compose_file="$(composeFileForEnv "$app_env")"; then
		exit 1
	fi

	dockerComposeFiles+=("$compose_file")

	if [ -f "$path/.docker/docker-compose.override.yml" ]; then
		dockerComposeFiles+=("docker-compose.override.yml")
	fi

	local result="docker compose "
	for i in "${dockerComposeFiles[@]}"; do
		result+="-f $path/.docker/$i "
	done

	echo "$result"
}

runOrExec() {
	local service=$1
	local container_id
	container_id=$("$path/corn" ps -q "$service")

	local result="exec"
	if [ -z "$container_id" ] || [ -z "$(docker ps -q --no-trunc | grep "$container_id")" ]; then
		result="run --rm"
	fi

	echo "$result $service"
}

initCommand=$(getInitCommand) || exit 1

if [ $# = 0 ]; then
	if [ "$info_flag" = 1 ]; then
		echo -e "${PURPLE}${initCommand}${NC}\n"
	fi
	$initCommand
	exit 0
fi

command=$1
shift 1

case $command in
	"php")
		payload="$(runOrExec php) $*" ;;
	"artisan" | "art" | "laravel" | "lara")
		payload="$(runOrExec php) /app/artisan $*" ;;
	"test")
		payload="$(runOrExec php) /app/vendor/bin/phpunit $*" ;;
	"composer")
		payload="$(runOrExec php) composer $*" ;;
	"yarn")
		payload="$(runOrExec nodejs) yarn $*" ;;
	"npx")
		payload="$(runOrExec nodejs) npx $*" ;;
	"nuxi")
		payload="$(runOrExec nodejs) npx nuxi $*" ;;
	*)
		payload="${command} $*" ;;
esac

fullCommand="${initCommand} ${payload}"

if [ "$info_flag" = 1 ]; then
	echo -e "${PURPLE}${fullCommand}${NC}\n"
fi

if [ "$dry_run_flag" = 0 ]; then
	$fullCommand
fi
